{
  "name": "media-generation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0", "npm": ">=10.0.0" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "nx run-many -t serve --projects=frontend,backend --parallel=2",
    "build": "nx run-many -t build --projects=frontend,backend",
    "test": "nx run backend:test",
    "typecheck": "nx run-many -t typecheck --projects=frontend,backend",
    "lint": "nx run-many -t lint --projects=frontend,backend",
    "lint:fix": "nx run-many -t lint:fix --projects=frontend,backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@supabase/supabase-js": "^2.57.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "jest": "^30.1.3",
    "nx": "^21.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2"
  }
}