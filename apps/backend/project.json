{
  "name": "backend",
  "sourceRoot": "apps/backend",
  "projectType": "application",
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "npm run build --prefix apps/backend" } },
    "serve": { "executor": "nx:run-commands", "options": { "command": "npm run start:dev --prefix apps/backend" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "npm test --prefix apps/backend" } },
    "lint": {},
    "lint:fix": {},
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/backend/tsconfig.json" } }
  }
}